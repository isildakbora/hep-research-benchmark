{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEP Research Benchmark public starter task",
  "type": "object",
  "required": ["task_id", "family_id", "module_id", "profiles", "prompt", "attachments", "critical_requirements", "split", "validation_status"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[1-8][0-9]{2}$"},
    "family_id": {"type": "string", "pattern": "^F[1-8][0-9]{2}$"},
    "module_id": {"enum": ["M1","M2","M3","M4","M5","M6","M7","M8"]},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text","tools","full"]}},
    "prompt": {"type": "string", "minLength": 1},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "critical_requirements": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
    "split": {"const": "public_development"},
    "validation_status": {"const": "author_draft_not_independently_expert_validated"},
    "profile_overrides": {"type": "object", "additionalProperties": {"type": "object", "required": ["prompt","attachments"], "properties": {"prompt": {"type": "string"}, "attachments": {"type": "array", "items": {"type": "string"}}}}}
  },
  "additionalProperties": true
}
